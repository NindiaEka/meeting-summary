    {
      "parameters": {
        "jsCode": "const result = $json;\n\n// --- 1. RAKIT VERSI EMAIL (HTML) ---\nlet msgEmail = `<b>Minutes of Meeting</b><br><br>\n<b>Summary</b><br>\n${result.summary || 'Tidak ada summary dari meeting.'}<br><br>\n<b>Key Discussions</b><br>`;\n\nfor (const item of result.key_discussions || []) {\n  const text = typeof item === 'object' ? (item.description || item.text || item.discussion || JSON.stringify(item)) : item;\n  msgEmail += `• ${text}<br>`;\n}\n\nmsgEmail += `<br><b>Decisions</b><br>`;\nfor (const item of result.decisions || []) {\n  const text = typeof item === 'object' ? (item.description || item.text || item.decision || JSON.stringify(item)) : item;\n  msgEmail += `• ${text}<br>`;\n}\n\nmsgEmail += `<br><b>Action Items</b><br>`;\nfor (const item of result.action_items || []) {\n  if (typeof item === 'object' && item !== null) {\n    // Deteksi otomatis berbagai kemungkinan nama key untuk TUGAS\n    const tugas = item.action_item || item.task || item.description || item.text || '-';\n    // Deteksi otomatis berbagai kemungkinan nama key untuk PIC\n    const pic = item.responsibility || item.pic || item.assignee || 'Menyusul';\n    // Deteksi otomatis berbagai kemungkinan nama key untuk DEADLINE\n    const tenggat = item.deadline || item.time || item.due_date || 'Menyusul';\n    \n    msgEmail += `• ${tugas} | <b>PIC:</b> ${pic} | <b>Deadline:</b> ${tenggat}<br>`;\n  } else {\n    msgEmail += `• ${item}<br>`;\n  }\n}\n\n\n// --- 2. RAKIT VERSI WHATSAPP (MARKDOWN) ---\nlet msgWA = `*Minutes of Meeting*\\n\\n` +\n`*Summary*\\n` +\n`${result.summary || 'Tidak ada summary dari meeting.'}\\n\\n` +\n`*Key Discussions*\\n`;\n\nfor (const item of result.key_discussions || []) {\n  const text = typeof item === 'object' ? (item.description || item.text || item.discussion || JSON.stringify(item)) : item;\n  msgWA += `• ${text}\\n`;\n}\n\nmsgWA += `\\n*Decisions*\\n`;\nfor (const item of result.decisions || []) {\n  const text = typeof item === 'object' ? (item.description || item.text || item.decision || JSON.stringify(item)) : item;\n  msgWA += `• ${text}\\n`;\n}\n\nmsgWA += `\\n*Action Items*\\n`;\nfor (const item of result.action_items || []) {\n  if (typeof item === 'object' && item !== null) {\n    const tugas = item.action_item || item.task || item.description || item.text || '-';\n    const pic = item.responsibility || item.pic || item.assignee || 'Menyusul';\n    const tenggat = item.deadline || item.time || item.due_date || 'Menyusul';\n    \n    msgWA += `• ${tugas} | *PIC:* ${pic} | *Deadline:* ${tenggat}\\n`;\n  } else {\n    msgWA += `• ${item}\\n`;\n  }\n}\n\nreturn [\n  {\n    json: {\n      message_email: msgEmail.trim(),\n      message_wa: msgWA.trim()\n    }\n  }\n];"
      },
